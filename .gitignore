# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Claude Code session-local metadata
.claude/

# vercel
.vercel

# ingestion source content (large, copyrighted textbook PDFs)
/Data-Source/*
!/Data-Source/.gitkeep
!/Data-Source/README.md

# ingestion pipeline logs
/logs/

# python
__pycache__/
*.pyc
/ingestion/.venv/

# GCP service account keys — never commit
/ingestion/*.json

# typescript
*.tsbuildinfo
next-env.d.ts

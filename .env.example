# Groq API keys — add as many regional keys as you have (GROQ_API_KEY, GROQ_API_KEY_2, ...)
# The rotation layer in src/lib/groq/client.ts auto-discovers any env var matching GROQ_API_KEY(_N)?
GROQ_API_KEY=
GROQ_API_KEY_2=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Newer Supabase publishable/secret key pair (alternative to anon/service_role above)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Qdrant Cloud
QDRANT_URL=
QDRANT_API_KEY=
